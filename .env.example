# Server
PORT=3000
NODE_ENV=development

# Database - Choose one: mongo or postgres
DB_TYPE=mongo
MONGO_URI=mongodb://localhost:27017/lien-quan-checker
POSTGRES_URL=postgresql://user:password@localhost:5432/lien-quan_checker

# JWT Auth
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRE=7d

# Lien Quan API
LIENQUAN_API_URL=
LIENQUAN_API_TOKEN=
LIENQUAN_SCRAPER_URL=

# Admin User (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456
