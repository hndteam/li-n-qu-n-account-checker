PORT=3000
NODE_ENV=development

# Database - Choose one: mongo or postgres
DB_TYPE=mongo
MONGO_URI=mongodb://localhost:27017/lien-quan-checker
POSTGRES_URL=postgresql://user:password@localhost:5432/lien_quan_checker

# JWT Auth
JWT_SECRET=your-super-secret-key-change-this-minimum-32-chars
JWT_EXPIRE=7d

# Admin User (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# Liên Quân Data Providers
# Provider 1: Checker Garena (Community tool)
CHECKER_GARENA_URL=https://your-checker-garena-api.com
CHECKER_GARENA_TOKEN=your-api-token-here

# Provider 2: Official API (if available)
LIENQUAN_API_URL=
LIENQUAN_API_TOKEN=

# Provider 3: Web Scraper
LIENQUAN_SCRAPER_URL=

# Optional: Rate limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional: Redis cache
REDIS_URL=
